APP_NAME=Topgolik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=topgolik
DB_USERNAME=topgolik
DB_PASSWORD=local_development_only
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
TOPGOLIK_ESPN_LEAGUES=eng.1,esp.1,ger.1,ita.1,fra.1,tur.1,sui.1,uefa.champions
TOPGOLIK_PROVIDER_TIMEOUT=12

# Optional free no-key OpenLigaDB current-matchday feeds (do not duplicate ESPN ger.1)
TOPGOLIK_OPENLIGA_LEAGUES=bl2,bl3

# No-key public Premier League player form/goal/assist data; enable only with acceptable data rights.
TOPGOLIK_FPL_ENABLED=true
TOPGOLIK_FPL_CACHE_SECONDS=1800

# Provider sync success history is stored in PostgreSQL. Review logged freshness warnings every 15 minutes.

# Optional API-Football $0 plan: 100 requests/day, configured 80/day and 8/min safety budget.
# Obtain the key at https://dashboard.api-football.com/ ; NEVER commit a real key.
TOPGOLIK_API_FOOTBALL_ENABLED=false
TOPGOLIK_API_FOOTBALL_KEY=
TOPGOLIK_API_FOOTBALL_COUNTRY=Turkey
TOPGOLIK_API_FOOTBALL_DAILY_BUDGET=80
TOPGOLIK_API_FOOTBALL_MINUTE_BUDGET=8
TOPGOLIK_API_FOOTBALL_AUTO_SYNC=false
