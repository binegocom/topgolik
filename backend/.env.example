APP_NAME=Topgolik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=topgolik
DB_USERNAME=topgolik
DB_PASSWORD=local_development_only
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
TOPGOLIK_ESPN_LEAGUES=eng.1,esp.1,ger.1,ita.1,fra.1,tur.1,sui.1,uefa.champions
TOPGOLIK_PROVIDER_TIMEOUT=12

# Set to an empty string to disable OpenLigaDB ingestion.
TOPGOLIK_OPENLIGA_LEAGUES=bl1,bl2,bl3
