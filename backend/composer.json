{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "binego/topgolik-api",
  "description": "Topgolik football scores API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "laravel/pint": "^1.27",
    "nunomaduro/collision": "^8.0"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "test": ["@php artisan test"]
  },
  "config": {"sort-packages": true, "optimize-autoloader": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
